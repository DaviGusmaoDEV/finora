# Runtime
NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_app

# Authentication (generate locally; never commit real values)
SESSION_SECRET=replace-with-a-long-random-value
COOKIE_NAME=finora_session

# Development-only demo seed (never use in production)
DEMO_PASSWORD=change-this-only-for-local-demo
