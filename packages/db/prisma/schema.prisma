generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  DIGITAL_WALLET
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELED
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(120)
  email        String          @unique @db.VarChar(320)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  preference   UserPreference?
  accounts     Account[]
  categories   Category[]
  sessions     Session[]
  transactions Transaction[]
  transfers    Transfer[]
  @@map("users")
}

model UserPreference {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  currency            String    @default("BRL") @db.Char(3)
  locale              String    @default("pt-BR") @db.VarChar(16)
  timezone            String    @default("America/Sao_Paulo") @db.VarChar(64)
  theme               ThemeMode @default(SYSTEM)
  dateFormat          String    @default("dd/MM/yyyy") @map("date_format") @db.VarChar(32)
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_preferences")
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String      @db.VarChar(120)
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currency       String      @default("BRL") @db.Char(3)
  institution    String?     @db.VarChar(120)
  description    String?     @db.VarChar(500)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  outgoingTransfers Transfer[] @relation("TransferSource")
  incomingTransfers Transfer[] @relation("TransferDestination")
  @@index([userId, isActive])
  @@map("accounts")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  accountId       String            @map("account_id") @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  description     String            @db.VarChar(160)
  amount          Decimal           @db.Decimal(14, 2)
  transactionDate DateTime          @map("transaction_date") @db.Timestamptz(3)
  dueDate         DateTime?         @map("due_date") @db.Date
  paidAt          DateTime?         @map("paid_at") @db.Timestamptz(3)
  notes           String?           @db.VarChar(1000)
  canceledAt      DateTime?         @map("canceled_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@index([userId, transactionDate])
  @@index([userId, status, dueDate])
  @@index([userId, type, transactionDate])
  @@index([accountId, status, transactionDate])
  @@index([categoryId, status, transactionDate])
  @@map("transactions")
}

model Transfer {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  sourceAccountId    String   @map("source_account_id") @db.Uuid
  destinationAccountId String @map("destination_account_id") @db.Uuid
  amount             Decimal  @db.Decimal(14, 2)
  transferDate       DateTime @map("transfer_date") @db.Timestamptz(3)
  description        String?  @db.VarChar(160)
  notes              String?  @db.VarChar(1000)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount      Account  @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account  @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  @@index([userId, transferDate])
  @@index([sourceAccountId, transferDate])
  @@index([destinationAccountId, transferDate])
  @@map("transfers")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  name      String       @db.VarChar(80)
  type      CategoryType
  icon      String?      @db.VarChar(40)
  isSystem  Boolean      @default(false) @map("is_system")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]   @relation("CategoryTree")
  transactions Transaction[]
  @@index([userId, type, isActive])
  @@index([parentId])
  @@unique([userId, name, type, parentId])
  @@map("categories")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}
